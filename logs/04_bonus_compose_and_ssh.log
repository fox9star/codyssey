# --- [1] 환경 변수(ENV) 주입으로 컨테이너 내부 리슨 포트(9090) 및 실행 모드 변경 ---
$ docker run -d -p 8084:9090 --name my-web-env -e SERVER_PORT=9090 -e APP_ENV=custom-prod -e APP_VERSION=2.0.0 codyssey-web:1.0
